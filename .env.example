# Postgres local (docker compose up -d db). Para usar la base de Neon que
# envió Cocos, reemplazar por esa URL en un .env (nunca commitear el .env).
DATABASE_URL=postgres://cocos:cocos@localhost:5432/cocos
# Solo para tests e2e: se borra y recrea en cada test.
TEST_DATABASE_URL=postgres://cocos:cocos@localhost:5432/cocos_test
PORT=3000
# false = no correr las migraciones al arrancar. Solo sirve si la base ya está
# migrada: sin las columnas de idempotencia de orders, la API no puede leer ni
# escribir órdenes. Para no tocar la base de Neon, usar la base local de Docker.
DB_RUN_MIGRATIONS=true
# Nivel de los logs: info por defecto; debug para ver el detalle de cada decisión.
LOG_LEVEL=info
